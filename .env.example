# ─────────────────────────────────────────────────────────────
# SURGIRSTUDIO — variables de entorno
# Copia este archivo a `.env` para desarrollo local y define las
# mismas variables (sin valores de ejemplo) en Netlify → Site settings
# → Environment variables. NUNCA subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────

# --- Modo de autenticación ------------------------------------
# true  = demo (sin backend, sesión simulada en localStorage)
# false = OAuth real vía Netlify Function
VITE_AUTH_DEMO=true

# --- Frontend: OAuth publico (solo Client IDs y redirect URIs) ---
# (Opcional en demo; obligatorias cuando VITE_AUTH_DEMO=false)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=

VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=

# --- Backend (Netlify Functions) — NUNCA expongas estas en el frontend ---
# Client IDs (idénticos a los de arriba)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Secreto para firmar la cookie de sesión (genera uno largo y aleatorio).
SESSION_SECRET=

# URL a la que redirige tras un login correcto (por defecto: /#/account).
AUTH_SUCCESS_URL=

# --- Contenido / contacto (opcional) ---
VITE_CONTACT_ENDPOINT=