# ─────────────────────────────────────────────────────────────
# SURGIRSTUDIO — variables de entorno
# Copia este archivo a `.env` para desarrollo local y define las
# mismas variables (sin valores de ejemplo) en Netlify → Site settings
# → Environment variables. NUNCA subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────

# --- Contenido / contacto (opcional) ---
# Endpoint backend que recibe el formulario de Contacto (POST JSON).
# Si está vacío, el formulario se valida y muestra el estado "preparado",
# sin simular un envío real.
VITE_CONTACT_ENDPOINT=

# --- Preparado para el futuro (NO usado por el flujo actual) ---
# El flujo web actual es: producto gratis → correo → descarga activada
# (localStorage). No usa cuentas. Estas variables quedan documentadas por si
# más adelante se reactiva OAuth (Google/Discord) y el envío de correo real.
#
# VITE_AUTH_DEMO=true
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_REDIRECT_URI=
# VITE_DISCORD_CLIENT_ID=
# VITE_DISCORD_REDIRECT_URI=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
# SESSION_SECRET=
# AUTH_SUCCESS_URL=